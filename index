                        <form id="expenseForm" onsubmit="handleExpenseSubmit(event)" class="space-y-4">
                            <input type="hidden" id="editExpenseId" value="">
                            
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-semibold text-slate-300 mb-1.5">Gider Kategorisi</label>
                                    <select id="expenseCategory" class="w-full px-3.5 py-3 bg-slate-900 border border-slate-700/80 rounded-xl text-white focus:outline-none focus:border-emerald-500 font-medium" required>
                                        <option value="Barınma & Kira">🏠 Barınma & Kira</option>
                                        <option value="Elektrik Faturası">⚡ Elektrik Faturası</option>
                                        <option value="Su Faturası">💧 Su Faturası</option>
                                        <option value="Doğalgaz Faturası">🔥 Doğalgaz Faturası</option>
