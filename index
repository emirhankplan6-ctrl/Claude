            </div>

            <!-- Main Layout Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

                <!-- Left Column: Form & List (7/12) -->
                <div class="lg:col-span-7 space-y-6">

                    <!-- Gider Ekleme Formu -->
                    <div class="glass-card p-6 rounded-2xl shadow-xl">
