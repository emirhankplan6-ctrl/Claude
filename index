                                        <input type="number" id="expenseAmount" step="1" min="1" placeholder="0" class="w-full pl-9 pr-3.5 py-3 bg-slate-900 border border-slate-700/80 rounded-xl text-white font-bold placeholder-slate-600 focus:outline-none focus:border-emerald-500" required>
                                    </div>
