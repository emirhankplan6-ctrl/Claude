                                <option value="Barınma & Kira">Barınma & Kira</option>
                                <option value="Elektrik Faturası">Elektrik</option>
                                <option value="Su Faturası">Su</option>
                                <option value="Doğalgaz Faturası">Doğalgaz</option>
                                <option value="İnternet Faturası">İnternet</option>
                                <option value="Telefon 1">Telefon 1</option>
                                <option value="Telefon 2">Telefon 2</option>
                                <option value="Market & Mutfak">Market</option>
                                <option value="Pazar Parası">Pazar Parası</option>
                                <option value="Diğer Özel Kalemler">Diğer Özel</option>
                            </select>
