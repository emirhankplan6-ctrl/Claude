    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 glass-card text-white px-4 py-3 rounded-2xl shadow-2xl flex items-center gap-3 text-xs border border-slate-700">
        <i id="toastIcon" class="fa-solid fa-circle-check text-emerald-400 text-base"></i>
        <span id="toastMsg" class="font-semibold">İşlem Başarılı</span>
    </div>

    <!-- Scripts Logic -->
    <script>
        // Setup Dynamic Manifest for Native PWA Installation
        (function setupManifest() {
            const manifest = {
                name: "BütçeYönetim Takip",
                short_name: "BütçeYönetim",
                start_url: ".",
                display: "standalone",
                background_color: "#090d16",
                theme_color: "#090d16",
                icons: [
                    {
                        src: "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512' fill='%2310b981'><path d='M64 32C28.7 32 0 60.7 0 96V416c0 35.3 28.7 64 64 64H448c35.3 0 64-28.7 64-64V192c0-35.3-28.7-64-64-64H80c-8.8 0-16-7.2-16-16s7.2-16 16-16H448c13.3 0 24-10.7 24-24s-10.7-24-24-24H64zM416 336a32 32 0 1 0 0-64 32 32 0 1 0 0 64z'/></svg>",
                        sizes: "512x512",
                        type: "image/svg+xml"
                    }
                ]
            };
            const stringManifest = JSON.stringify(manifest);
            const blob = new Blob([stringManifest], {type: 'application/json'});
            const manifestURL = URL.createObjectURL(blob);
            document.getElementById('manifestPlaceholder').setAttribute('href', manifestURL);
        })();

        // Register Service Worker for Offline Capabilities
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                const swCode = `
                    const CACHE_NAME = 'budget-app-v2';
                    self.addEventListener('install', (e) => {
                        e.waitUntil(
                            caches.open(CACHE_NAME).then((cache) => {
                                return cache.addAll(['./']);
                            })
                        );
                    });
                    self.addEventListener('fetch', (e) => {
                        e.respondWith(
                            caches.match(e.request).then((res) => res || fetch(e.request))
                        );
                    });
                `;
                const blob = new Blob([swCode], { type: 'text/javascript' });
                const swUrl = URL.createObjectURL(blob);
                navigator.serviceWorker.register(swUrl).catch(() => {});
            });
        }

        // Deferred PWA Prompt
        let deferredPrompt;
        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;
        });

        function triggerPwaInstall() {
            if (deferredPrompt) {
                deferredPrompt.prompt();
                deferredPrompt.userChoice.then((choiceResult) => {
                    if (choiceResult.outcome === 'accepted') {
                        showToast('Uygulama başarıyla yüklendi!');
                    }
                    deferredPrompt = null;
                });
            } else {
                openPwaGuide();
            }
        }

        // App Data State
        let state = {
            totalIncome: 70000,
            expenses: [
                { id: '1', category: 'Barınma & Kira', amount: 15000 },
                { id: '2', category: 'Elektrik Faturası', amount: 850 },
                { id: '3', category: 'Su Faturası', amount: 320 },
                { id: '4', category: 'Doğalgaz Faturası', amount: 1400 },
                { id: '5', category: 'İnternet Faturası', amount: 350 },
                { id: '6', category: 'Telefon 1', amount: 450 },
                { id: '7', category: 'Telefon 2', amount: 400 },
                { id: '8', category: 'Market & Mutfak', amount: 12000 },
                { id: '9', category: 'Pazar Parası', amount: 4000 },
                { id: '10', category: 'Diğer Özel Kalemler', amount: 5000 }
            ],
            chartType: 'doughnut'
        };

        const categoryColors = {
            'Barınma & Kira': '#3b82f6',
            'Elektrik Faturası': '#f59e0b',
            'Su Faturası': '#06b6d4',
            'Doğalgaz Faturası': '#f97316',
            'İnternet Faturası': '#6366f1',
            'Telefon 1': '#8b5cf6',
            'Telefon 2': '#a855f7',
            'Market & Mutfak': '#10b981',
            'Pazar Parası': '#84cc16',
            'Ulaşım & Yakıt': '#ec4899',
            'Taksit & Borçlar': '#f43f5e',
            'Diğer Özel Kalemler': '#64748b'
        };

        let chartInstance = null;

        window.onload = function() {
            loadFromLocalStorage();
            initChart();
            renderAll();
        };

        function saveToLocalStorage() {
            localStorage.setItem('offline_budget_data_v3', JSON.stringify(state));
        }

        function loadFromLocalStorage() {
            const saved = localStorage.getItem('offline_budget_data_v3');
            if (saved) {
                try {
                    state = JSON.parse(saved);
                } catch (e) {
                    console.error('Veri yükleme hatası', e);
                }
            }
        }

        function confirmReset() {
            if (confirm('Tüm verilerinizi tamamen silmek istediğinize emin misiniz?')) {
                state.totalIncome = 0;
                state.expenses = [];
                saveToLocalStorage();
                renderAll();
                showToast('Tüm veriler sıfırlandı.', 'info');
            }
        }

        function loadSampleData() {
            state.totalIncome = 70000;
            state.expenses = [
                { id: '1', category: 'Barınma & Kira', amount: 15000 },
                { id: '2', category: 'Elektrik Faturası', amount: 850 },
                { id: '3', category: 'Su Faturası', amount: 320 },
                { id: '4', category: 'Doğalgaz Faturası', amount: 1400 },
                { id: '5', category: 'İnternet Faturası', amount: 350 },
                { id: '6', category: 'Telefon 1', amount: 450 },
                { id: '7', category: 'Telefon 2', amount: 400 },
                { id: '8', category: 'Market & Mutfak', amount: 12000 },
                { id: '9', category: 'Pazar Parası', amount: 4000 },
                { id: '10', category: 'Diğer Özel Kalemler', amount: 5000 }
            ];
            saveToLocalStorage();
            renderAll();
            showToast('Örnek bütçe şablonu yüklendi.');
        }

        function formatTL(val) {
            return new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY', maximumFractionDigits: 0 }).format(val);
        }

        function calculateTotals() {
            const totalExpenses = state.expenses.reduce((acc, curr) => acc + Number(curr.amount), 0);
            const remaining = state.totalIncome - totalExpenses;
            const expenseRatio = state.totalIncome > 0 ? (totalExpenses / state.totalIncome) * 100 : 0;
            return { totalExpenses, remaining, expenseRatio };
        }

        function renderAll() {
            renderHeaderCards();
            renderExpenses();
            renderAnalysis();
            updateChart();
        }

        function renderHeaderCards() {
            const { totalExpenses, remaining, expenseRatio } = calculateTotals();

            document.getElementById('displayTotalIncome').innerText = formatTL(state.totalIncome);
            document.getElementById('displayTotalExpense').innerText = formatTL(totalExpenses);
            document.getElementById('displayRemaining').innerText = formatTL(remaining);

            document.getElementById('displayExpenseRatio').innerText = `%${expenseRatio.toFixed(1)} harcandı`;

            const progress = Math.min(Math.max(expenseRatio, 0), 100);
            const progressBar = document.getElementById('budgetProgressBar');
            const percentText = document.getElementById('budgetPercentText');
            
            progressBar.style.width = `${progress}%`;
            percentText.innerText = `%${expenseRatio.toFixed(1)}`;

            if (expenseRatio > 100) {
                progressBar.className = 'bg-gradient-to-r from-rose-600 to-red-500 h-1.5 rounded-full transition-all duration-500';
            } else if (expenseRatio > 80) {
                progressBar.className = 'bg-gradient-to-r from-amber-500 to-orange-400 h-1.5 rounded-full transition-all duration-500';
            } else {
                progressBar.className = 'bg-gradient-to-r from-emerald-500 to-teal-400 h-1.5 rounded-full transition-all duration-500';
            }

            const remainingStatus = document.getElementById('displayRemainingStatus');
            const remainingIconBg = document.getElementById('remainingIconBg');

            if (remaining < 0) {
                remainingStatus.innerText = 'Açık Var!';
                remainingStatus.className = 'text-xs font-semibold text-rose-400';
                remainingIconBg.className = 'w-8 h-8 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 flex items-center justify-center text-sm';
            } else {
                remainingStatus.innerText = 'Dengede';
                remainingStatus.className = 'text-xs font-semibold text-emerald-400';
                remainingIconBg.className = 'w-8 h-8 rounded-xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 flex items-center justify-center text-sm';
            }
        }

        function renderExpenses() {
            const container = document.getElementById('expenseListContainer');
            const emptyState = document.getElementById('emptyListState');
            const filter = document.getElementById('filterCategory').value;

            container.innerHTML = '';

            const filteredExpenses = state.expenses.filter(item => {
                if (filter === 'ALL') return true;
                return item.category === filter;
            });

            if (filteredExpenses.length === 0) {
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');

                filteredExpenses.forEach(exp => {
                    const ratio = state.totalIncome > 0 ? ((exp.amount / state.totalIncome) * 100).toFixed(1) : 0;
                    const catColor = categoryColors[exp.category] || '#64748b';

                    const itemDiv = document.createElement('div');
                    itemDiv.className = 'p-4 flex items-center justify-between hover:bg-slate-900/60 transition-all duration-200 animate-fade-in group';
                    itemDiv.innerHTML = `
                        <div class="flex items-center space-x-3">
                            <div class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: ${catColor}; box-shadow: 0 0 8px ${catColor}80"></div>
                            <div>
                                <div class="font-bold text-white text-sm">${exp.category}</div>
                                <div class="text-[11px] text-slate-400">Gelirin %${ratio}'i</div>
                            </div>
                        </div>
                        <div class="flex items-center space-x-3">
                            <span class="font-extrabold text-white text-base">${formatTL(exp.amount)}</span>
                            <div class="flex items-center space-x-1 opacity-80 group-hover:opacity-100 transition-opacity">
                                <button onclick="editExpense('${exp.id}')" title="Düzenle" class="p-2 text-slate-400 hover:text-emerald-400 rounded-lg hover:bg-slate-800">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                                <button onclick="deleteExpense('${exp.id}')" title="Sil" class="p-2 text-slate-400 hover:text-rose-400 rounded-lg hover:bg-slate-800">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </div>
                        </div>
                    `;
                    container.appendChild(itemDiv);
                });
            }
        }

        function renderAnalysis() {
            const container = document.getElementById('analysisContainer');
            container.innerHTML = '';

            const { totalExpenses, remaining, expenseRatio } = calculateTotals();
            const insights = [];

            if (state.totalIncome <= 0) {
                insights.push({
                    type: 'warning',
                    icon: 'fa-triangle-exclamation',
                    title: 'Gelir Eklemeniz Gerekiyor',
                    text: 'Net bütçe oranlarını görmek için lütfen gelirinizi giriniz.'
                });
            } else if (remaining < 0) {
                insights.push({
                    type: 'danger',
                    icon: 'fa-circle-exclamation',
                    title: 'Bütçe Aşımı',
                    text: `Harcamalarınız gelirinizi **${formatTL(Math.abs(remaining))}** aştı.`
                });
            } else {
                insights.push({
                    type: 'success',
                    icon: 'fa-circle-check',
                    title: 'Kalan Kullanılabilir Bütçe',
                    text: `Gelirinizin %${(100 - expenseRatio).toFixed(1)} kadarı (**${formatTL(remaining)}**) cebinizde kalıyor.`
                });
            }

            if (state.expenses.length > 0 && state.totalIncome > 0) {
                const totalsByCategory = {};
                state.expenses.forEach(exp => {
                    totalsByCategory[exp.category] = (totalsByCategory[exp.category] || 0) + Number(exp.amount);
                });

                let maxCat = '';
                let maxAmt = 0;
                for (const [cat, amt] of Object.entries(totalsByCategory)) {
                    if (amt > maxAmt) {
                        maxAmt = amt;
                        maxCat = cat;
                    }
                }

                const maxPct = ((maxAmt / state.totalIncome) * 100).toFixed(1);
                insights.push({
                    type: 'info',
                    icon: 'fa-chart-pie',
                    title: 'En Yüksek Harcama Kalemi',
                    text: `En büyük gider: **${maxCat}** (%${maxPct} - ${formatTL(maxAmt)})`
                });
            }

            insights.forEach(item => {
                let bgClass = 'bg-slate-900 border-slate-800 text-slate-300';
                let iconClass = 'text-cyan-400';

                if (item.type === 'danger') {
                    bgClass = 'bg-rose-950/30 border-rose-900/40 text-rose-300';
                    iconClass = 'text-rose-400';
                } else if (item.type === 'warning') {
                    bgClass = 'bg-amber-950/30 border-amber-900/40 text-amber-300';
                    iconClass = 'text-amber-400';
                } else if (item.type === 'success') {
                    bgClass = 'bg-emerald-950/30 border-emerald-900/40 text-emerald-300';
                    iconClass = 'text-emerald-400';
                }

                const card = document.createElement('div');
                card.className = `p-3.5 rounded-2xl border ${bgClass} text-xs flex gap-3 items-center`;
                card.innerHTML = `
                    <i class="fa-solid ${item.icon} ${iconClass} text-base flex-shrink-0"></i>
                    <div>
                        <div class="font-bold text-white">${item.title}</div>
                        <div class="text-slate-400 mt-0.5 leading-relaxed">${item.text.replace(/\*\*(.*?)\*\*/g, '<strong class="text-white font-semibold">$1</strong>')}</div>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function handleExpenseSubmit(e) {
            e.preventDefault();
            const editId = document.getElementById('editExpenseId').value;
            const category = document.getElementById('expenseCategory').value;
            const amount = parseFloat(document.getElementById('expenseAmount').value);

            if (isNaN(amount) || amount <= 0) {
                showToast('Lütfen geçerli bir tutar giriniz.', 'error');
                return;
            }

            if (editId) {
                const idx = state.expenses.findIndex(i => i.id === editId);
                if (idx !== -1) {
                    state.expenses[idx] = { id: editId, category, amount };
                    showToast('Gider güncellendi.');
                }
            } else {
                state.expenses.push({
                    id: Date.now().toString(),
                    category,
                    amount
                });
                showToast('Gider eklendi.');
            }

            saveToLocalStorage();
            resetForm();
            renderAll();
        }

        function editExpense(id) {
            const exp = state.expenses.find(i => i.id === id);
            if (!exp) return;

            document.getElementById('editExpenseId').value = exp.id;
            document.getElementById('expenseCategory').value = exp.category;
            document.getElementById('expenseAmount').value = exp.amount;

            document.getElementById('submitBtn').innerHTML = '<i class="fa-solid fa-check"></i> Güncelle';
            document.getElementById('cancelBtn').classList.remove('hidden');

            window.scrollTo({ top: 100, behavior: 'smooth' });
        }

        function deleteExpense(id) {
            state.expenses = state.expenses.filter(i => i.id !== id);
            saveToLocalStorage();
            renderAll();
            showToast('Gider silindi.');
        }

        function resetForm() {
            document.getElementById('editExpenseId').value = '';
            document.getElementById('expenseAmount').value = '';
            document.getElementById('submitBtn').innerHTML = '<i class="fa-solid fa-plus"></i> Ekle';
            document.getElementById('cancelBtn').classList.add('hidden');
        }

        function openIncomeModal() {
            document.getElementById('inputModalIncome').value = state.totalIncome;
            const modal = document.getElementById('incomeModal');
            const card = document.getElementById('incomeModalCard');
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                card.classList.remove('scale-95');
                card.classList.add('scale-100');
            }, 10);
        }

        function closeIncomeModal() {
            const modal = document.getElementById('incomeModal');
            const card = document.getElementById('incomeModalCard');
            card.classList.remove('scale-100');
            card.classList.add('scale-95');
            modal.classList.add('opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 200);
        }

        function handleIncomeSave(e) {
            e.preventDefault();
            const val = parseFloat(document.getElementById('inputModalIncome').value);
            if (!isNaN(val) && val >= 0) {
                state.totalIncome = val;
                saveToLocalStorage();
                renderAll();
                closeIncomeModal();
                showToast('Gelir güncellendi.');
            }
        }

        function openPwaGuide() {
            const modal = document.getElementById('pwaModal');
            const card = document.getElementById('pwaModalCard');
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                card.classList.remove('scale-95');
                card.classList.add('scale-100');
            }, 10);
        }

        function closePwaGuide() {
            const modal = document.getElementById('pwaModal');
            const card = document.getElementById('pwaModalCard');
            card.classList.remove('scale-100');
            card.classList.add('scale-95');
            modal.classList.add('opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 200);
        }

        function initChart() {
            const ctx = document.getElementById('budgetChart').getContext('2d');
            chartInstance = new Chart(ctx, {
                type: state.chartType,
                data: {
                    labels: [],
                    datasets: [{
                        data: [],
                        backgroundColor: [],
                        borderWidth: 0,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                font: { family: 'Plus Jakarta Sans', size: 11 },
                                color: '#94a3b8',
                                boxWidth: 10,
                                padding: 12
                            }
                        },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            titleColor: '#fff',
                            bodyColor: '#cbd5e1',
                            borderColor: '#334155',
                            borderWidth: 1,
                            padding: 10,
                            callbacks: {
                                label: function(context) {
                                    const value = context.raw || 0;
                                    return ` ${context.label}: ${formatTL(value)}`;
                                }
                            }
                        }
                    },
                    cutout: '70%'
                }
            });
        }

        function updateChart() {
            if (!chartInstance) return;

            const totalsByCategory = {};
            state.expenses.forEach(exp => {
                totalsByCategory[exp.category] = (totalsByCategory[exp.category] || 0) + Number(exp.amount);
            });

            const labels = Object.keys(totalsByCategory);
            const data = Object.values(totalsByCategory);
            const colors = labels.map(cat => categoryColors[cat] || '#64748b');

            chartInstance.config.type = state.chartType;
            chartInstance.data.labels = labels;
            chartInstance.data.datasets[0].data = data;
            chartInstance.data.datasets[0].backgroundColor = colors;

            if (state.chartType === 'bar') {
                chartInstance.options.plugins.legend.display = false;
                chartInstance.options.scales = {
                    y: { 
                        beginAtZero: true,
                        ticks: { color: '#64748b', font: { family: 'Plus Jakarta Sans', size: 10 } },
                        grid: { color: '#1e293b' }
                    },
                    x: {
                        ticks: { color: '#64748b', font: { family: 'Plus Jakarta Sans', size: 10 } },
                        grid: { display: false }
                    }
                };
            } else {
                chartInstance.options.plugins.legend.display = true;
                chartInstance.options.scales = {};
            }

            chartInstance.update();
        }

        function toggleChartType(type) {
            state.chartType = type;
            const btnDoughnut = document.getElementById('btnDoughnut');
            const btnBar = document.getElementById('btnBar');

            if (type === 'doughnut') {
                btnDoughnut.className = 'px-2.5 py-1 rounded-lg font-semibold bg-emerald-600 text-white shadow';
                btnBar.className = 'px-2.5 py-1 rounded-lg font-semibold text-slate-400 hover:text-white';
            } else {
                btnBar.className = 'px-2.5 py-1 rounded-lg font-semibold bg-emerald-600 text-white shadow';
                btnDoughnut.className = 'px-2.5 py-1 rounded-lg font-semibold text-slate-400 hover:text-white';
            }

            if (chartInstance) {
                chartInstance.destroy();
            }
            initChart();
            updateChart();
        }

        function showToast(msg, type = 'success') {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');
            const toastIcon = document.getElementById('toastIcon');

            toastMsg.innerText = msg;

            if (type === 'error') {
                toastIcon.className = 'fa-solid fa-circle-xmark text-rose-400 text-base';
            } else if (type === 'info') {
                toastIcon.className = 'fa-solid fa-circle-info text-cyan-400 text-base';
            } else {
                toastIcon.className = 'fa-solid fa-circle-check text-emerald-400 text-base';
            }

            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 2500);
        }
    </script>
</body>
</html>
