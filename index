            <div class="flex justify-between items-center mb-4">
                <h3 class="text-base font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-coins text-emerald-400"></i> Toplam Gelir
                </h3>
                <button onclick="closeIncomeModal()" class="text-slate-400 hover:text-white p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <p class="text-xs text-slate-400 mb-4">Aylık net gelirinizi giriniz.</p>
            <form onsubmit="handleIncomeSave(event)">
                <div class="mb-5">
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 font-bold">₺</span>
                        <input type="number" id="inputModalIncome" step="100" min="0" class="w-full pl-9 pr-3.5 py-3 bg-slate-900 border border-slate-700 rounded-xl text-white font-extrabold text-lg focus:outline-none focus:border-emerald-500" required>
