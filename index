                        <div class="divide-y divide-slate-800/60 max-h-[400px] overflow-y-auto" id="expenseListContainer"></div>
                        
                        <div id="emptyListState" class="hidden p-8 text-center text-slate-500">
                            <i class="fa-solid fa-receipt text-3xl mb-2 text-slate-600"></i>
                            <p class="text-xs">Henüz eklenmiş bir gider bulunmuyor.</p>
                        </div>
