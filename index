                    </div>

                    <!-- Gider Listesi -->
                    <div class="glass-card rounded-2xl overflow-hidden shadow-xl">
                        <div class="p-4 sm:p-5 border-b border-slate-800/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
