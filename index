                                        <option value="Telefon 1">📱 Telefon 1</option>
                                        <option value="Telefon 2">📱 Telefon 2</option>
                                        <option value="Market & Mutfak">🛒 Market & Mutfak</option>
                                        <option value="Pazar Parası">🥬 Pazar Parası</option>
                                        <option value="Ulaşım & Yakıt">🚗 Ulaşım & Yakıt</option>
                                        <option value="Taksit & Borçlar">💳 Taksit & Borçlar</option>
